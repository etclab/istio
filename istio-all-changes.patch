+func createKCClient(opts *security.Options, a RootCertProvider) (security.KeyCuratorClient, error) {
+	log := log.WithLabels("kcclient", "impersonating CA")
+
+	var tlsOpts *kcclient.TLSOptions
+	var err error
+	// Special case: if Istiod runs on a secure network, on the default port, don't use TLS
+	// TODO: may add extra cases or explicit settings - but this is a rare use cases, mostly debugging
+	if strings.HasSuffix(opts.KCEndpoint, ":15010") {
+		log.Warn("Debug mode or IP-secure network")
+	} else {
+		tlsOpts = &kcclient.TLSOptions{}
+		tlsOpts.RootCert, err = a.FindRootCAForCA()
+		if err != nil {
+			return nil, fmt.Errorf("failed to find root CA cert for CA: %v", err)
+		}
+
+		if tlsOpts.RootCert == "" {
+			log.Infof("Using CA %s cert with system certs", opts.KCEndpoint)
+		} else if !fileExists(tlsOpts.RootCert) {
+			log.Fatalf("invalid config - %s missing a root certificate %s", opts.KCEndpoint, tlsOpts.RootCert)
+		} else {
+			log.Infof("Using CA %s cert with certs: %s", opts.KCEndpoint, tlsOpts.RootCert)
+		}
+
+		tlsOpts.Key, tlsOpts.Cert = a.GetKeyCertsForCA()
+	}
+
+	// Will use TLS unless the reserved 15010 port is used ( istiod on an ipsec/secure VPC)
+	// rootCert may be nil - in which case the system roots are used, and the CA is expected to have public key
+	// Otherwise assume the injection has mounted /etc/certs/root-cert.pem
+	return kcclient.NewKCClient(opts, tlsOpts)
+}
